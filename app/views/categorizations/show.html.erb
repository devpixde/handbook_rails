<% content_for :title, "Showing categorization" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing categorization</h1>

  <%= render @categorization %>

  <%= link_to "Edit this categorization", edit_categorization_path(@categorization), class: "button" %>
  <%= link_to "Back to categorizations", categorizations_path, class: "button" %>
  <%= button_to "Destroy this categorization", @categorization, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "danger-button", data: { turbo_confirm: "Are you sure?" } %>
</div>
