<% content_for :title, "Categorizations" %>

<div  class="container">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Categorizations</h1>
    <%= link_to "New categorization", new_categorization_path, class: "primary-button"%>
  </div>

  <div id="categorizations">
    <% if @categorizations.any? %>
      <% @categorizations.each do |categorization| %>
        <div class="flex flex-col sm:flex-row justify-between items-start py-5 sm:pb-0  gap-2">
          <%= render categorization %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", categorization, class: "button" %>
            <%= link_to "Edit", edit_categorization_path(categorization), class: "button" %>
            <%= button_to "Destroy", categorization, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No categorizations found.</p>
    <% end %>
  </div>
</div>
