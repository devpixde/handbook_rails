<div id="<%= dom_id todo %>" class="todo-tile flex flex-col justify-between sm:w-auto my-5 space-y-5 p-5 rounded-lg shadow-md border border-gray-200" style="background-color: <%= todo.color %>;">
  <section>
    <h2>
      <%= todo.title %>
    </h2>
    <%= render 'categories', categories: todo.categories %>
    <article class="p-2 rounded-lg bg-white my-4 border border-gray-200">
      <%= todo.body %>
    </article>
    <article class="flex flex-wrap gap-2">
      <div>
        Pinned: <%= checked_unchecked todo.pinned? %>
      </div>
      <div>
        Deleted: <%= checked_unchecked todo.deleted? %>
      </div>
      <div>
        Published:<%= checked_unchecked todo.published? %>
      </div>
      <div>
        Done:<%= checked_unchecked todo.done? %>
      </div>
    </article>
    <div>
      <strong class="font-medium mb-1">Duedate:</strong>
      <%= todo.duedate %>
    </div>
  </section>
  <section>
    <hr>
    <div class="w-full flex justify-center items-center gap-2 mt-4">
      <%= link_to "Show", todo, class: "button" %>
      <%= link_to "Edit", edit_todo_path(todo), class: "button" %>
      <%= button_to "Destroy", todo, method: :delete, class: "danger-button", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </section>
</div>
