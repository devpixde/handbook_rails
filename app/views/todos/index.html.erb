<% content_for :title, "Todos" %>

<!-- Dieser Aufruf öffnet eine Console im Browser in der die Umgebung der Seite angezeigt wird. -->

<% console %>

<div class="w-full">
  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Todos</h1>
    <%= link_to "New todo", new_todo_path, class: "primary-button" %>
  </div>

  <div id="todos" class="min-w-full todo-tiles-container">
    <% if @todos.any? %>
      <% @todos.each do |todo| %>
          <%= render todo %>
      <% end %>
    <% else %>
      <p class="text-center my-10">No todos found.</p>
    <% end %>
  </div>
</div>
