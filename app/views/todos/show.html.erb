<% content_for :title, "Showing todo" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing todo</h1>
  <%= render @todo %>
  <%= link_to "Edit this todo", edit_todo_path(@todo), class: "button" %>
  <%= link_to "Back to todos", todos_path, class: "button" %>
  <%= button_to "Destroy this todo", @todo, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "danger-button", data: { turbo_confirm: "Are you sure?" } %>

  <%= render 'comments', comments: @comments  %>
</div>
