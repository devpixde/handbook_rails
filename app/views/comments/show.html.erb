<% content_for :title, "Showing comment" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing comment</h1>

  <%= render @comment %>

  <%= link_to "Edit this comment", edit_comment_path(@comment), class: "button" %>
  <%= link_to "Back to comments", comments_path, class: "button" %>
  <%= button_to "Destroy this comment", @comment, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "danger-button", data: { turbo_confirm: "Are you sure?" } %>
</div>
