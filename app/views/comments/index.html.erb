<% content_for :title, "Comments" %>

<div class="container">
  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Comments</h1>
    <%= link_to "New comment", new_comment_path, class: "primary-button" %>
  </div>

  <div id="comments" >
    <% if @comments.any? %>
      <% @comments.each do |comment| %>
        <div class="flex flex-col sm:flex-row justify-between items-start py-5 sm:pb-0  gap-2">
          <%= render comment %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", comment, class: "button" %>
            <%= link_to "Edit", edit_comment_path(comment), class: "button" %>
            <%= button_to "Destroy", comment, method: :delete, class: "danger-button", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No comments found.</p>
    <% end %>
  </div>
</div>
